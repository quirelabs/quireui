{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "quireui",
  "homepage": "https://example.com",
  "items": [
    {
      "name": "foundation",
      "type": "registry:file",
      "title": "Foundation",
      "description": "Tokens, density and motion utilities. Every component depends on this.",
      "files": [
        {
          "path": "registry/styles/quireui.css",
          "type": "registry:file",
          "target": "~/styles/quireui.css"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "The cn helper that merges class names and resolves Tailwind conflicts.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "registry/lib/cn.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "input-modality",
